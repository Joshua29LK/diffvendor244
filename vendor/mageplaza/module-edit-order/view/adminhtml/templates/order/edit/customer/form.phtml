<script>
    require(['jquery'], function ($) {
        var editorderInput     = $('#mpeditorder-save-customer'),
            associateToWebsite = $('.field-mpeditorder-customer-website-id'),
            emailFrom          = $('.field-mpeditorder-customer-sendemail_store_id'),
            groupOptions       = $('select#mpeditorder-customer-group option');


        $(editorderInput).click(function(){
            if($(this).is(":checked")){
                associateToWebsite.show();
                emailFrom.show();

                if ($('#mpeditorder-customer-email').hasClass('isset-email') === false){
                    groupOptions.each(function () {
                        var el = $(this);

                        if(parseInt(el.attr('value')) === 0){
                            el.attr('hidden','hidden');
                            el.removeAttr('selected');
                        }else{
                            el.removeAttr('hidden');
                            if (parseInt(el.attr('value')) === 1) {
                                el.attr('selected','selected');
                            }
                        }
                    });
                }
            }else{
                associateToWebsite.hide();
                emailFrom.hide();

                if ($('#mpeditorder-customer-email').hasClass('isset-email') === false){
                    groupOptions.each(function () {
                        var el = $(this);

                        if(parseInt(el.attr('value')) === 0){
                            el.removeAttr('hidden');
                            el.attr('selected','selected');
                        }else{
                            el.attr('hidden','hidden');
                            el.removeAttr('selected');
                        }
                    });
                }
            }
        });
    });
</script>
