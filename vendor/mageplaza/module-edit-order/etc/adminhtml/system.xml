<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="mpeditorder" translate="label" type="text" sortOrder="300" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Edit Order</label>
            <tab>mageplaza</tab>
            <resource>Mageplaza_EditOrder::configuration</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Select Yes to enable this module</comment>
                </field>
                <field id="editable_order_status" translate="label comment" type="multiselect" sortOrder="20" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Only order in this status can be edited</label>
                    <source_model>Mageplaza\EditOrder\Model\Config\Source\OrderStatus</source_model>
                    <comment>Select editable order status</comment>
                </field>

                <field id="update_after_editing" translate="label comment" type="select" sortOrder="25" showInDefault="1" showInWebsite="0" showInStore="0" canRestore="1">
                    <label>Update Invoices/Shipments/Credit Memos After Editing</label>
                    <source_model>Mageplaza\EditOrder\Model\Config\Source\UpdateAfterEdit</source_model>
                    <comment>Choose how to change the value of Invoices, Shipments and Credit Memos after editing the item and shipping order</comment>
                </field>

                <field id="enabled_quick_edit" translate="label" type="select" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Quick Edit</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="auto_recalculate_shipping_fee" translate="label" type="select" sortOrder="35" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Auto Recalculate Shipping Fee</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="return_item_to_stock" translate="label comment" type="select" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Enable Return Item To Stock</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Select Yes to return item to stock after items are removed or the item quantity decreased.</comment>
                </field>
            </group>
        </section>
    </system>
</config>
